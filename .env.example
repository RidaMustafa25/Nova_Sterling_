# Copy to .env.local (and add the same variables in Vercel > Project > Settings > Environment Variables).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=6586a93f8ab5afd4719d0b4233f99e37ffb102a8ce79bdbc02e065575a51fd4a
# Vercel Blob token. Added automatically when you connect a Blob store to the project on Vercel.
# Leave empty locally to save to the /content folder on disk instead.
BLOB_READ_WRITE_TOKEN=
